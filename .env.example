# Lokal saja. Node.js 24 atau lebih baru.
PORT=3000
# Demo gratis: gunakan Ollama. Model diunduh sekali, lalu berjalan lokal tanpa biaya API.
RAG_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=bge-m3
# Alternatif berbayar: set RAG_PROVIDER=openai dan isi kunci di bawah.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Model API tidak dipanggil sampai kunci tersedia. Jangan kirim API key ke chat.
